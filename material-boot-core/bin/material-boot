#!/bin/sh
# material-boot: the one command. `material-boot` alone opens a menu; `material-boot help` lists what is installed. The code is material_boot/cli.py.
# $MATERIAL_LIB is the directory that holds the material_boot package (the packages install it under /usr/share/material-boot/lib); in a checkout it is the
# repository itself. /var/lib/material-grub/env (written by the installer) may name another Python (MATERIAL_PY) for systems whose python3 is too old.
HERE=$(cd "$(dirname "$0")" && pwd)
LIB=/usr/share/material-boot/lib; [ -d "$HERE/../material_boot" ] && LIB=$(cd "$HERE/.." && pwd)
PY=python3
[ -f /var/lib/material-grub/env ] && . /var/lib/material-grub/env
[ -n "$MATERIAL_LIB" ] && LIB=$MATERIAL_LIB; [ -n "$MATERIAL_PY" ] && PY=$MATERIAL_PY
"$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null || {
  echo "material-boot: Python 3.9 or newer is needed ('$PY' is not): install one and name it in MATERIAL_PY (/var/lib/material-grub/env)" >&2; exit 1; }
MB_CLI_SELF=$0; export MB_CLI_SELF
PYTHONPATH="$LIB${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m material_boot "$@"
