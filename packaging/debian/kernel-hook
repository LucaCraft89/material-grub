#!/bin/sh
# /etc/kernel/postinst.d and postrm.d: a kernel was added or removed. Re-applies the theme through the same safety nets; never fails the kernel package.
for mb in /usr/bin/material-boot /usr/local/bin/material-boot; do
  [ -x "$mb" ] && { "$mb" grub apply >/dev/null 2>&1 || true; exit 0; }
done
exit 0
