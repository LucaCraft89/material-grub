[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/lib/modules/*/vmlinuz

[Action]
Description = Re-applying the Material GRUB theme after a kernel change...
When = PostTransaction
Exec = /bin/sh -c '[ -x /usr/local/bin/material-grub ] && /usr/local/bin/material-grub apply || true'
