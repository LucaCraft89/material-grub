#!/usr/bin/env python3
"""material-grub-gui: the optional graphical editor for the Material GRUB theme (opens in your web browser). usage: material-grub-gui [--port N] [--no-browser] [--idle SECONDS]"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))


def main(argv):
    def arg(n, d=None):
        return argv[argv.index(n) + 1] if n in argv else d

    if "-h" in argv or "--help" in argv:
        print(__doc__)
        return 0
    import mgserver

    return mgserver.serve(int(arg("--port", 0)), int(arg("--idle", 120)), "--no-browser" not in argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
