<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!-- The only thing the Material GRUB GUI runs as root. The helper takes one JSON request on stdin and does a fixed list of things (see gui/mghelper.py);
     every change asks for the administrator's password or fingerprint (no caching). -->
<policyconfig>
  <vendor>Material GRUB</vendor>
  <vendor_url>https://github.com/LucaCraft89/material-grub</vendor_url>
  <action id="org.material-grub.gui.run">
    <description>Change the Material GRUB boot menu theme</description>
    <message>Authentication is required to change your GRUB boot menu</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/material-grub-gui-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
