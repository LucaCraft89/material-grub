#!/usr/bin/env python3
"""Assemble the active theme directory for a given gfx mode. stdlib only.
usage: material-grub-assemble --mode WxH --pkg DIR --out DIR   (prints the resolution actually chosen)"""
import json, os, shutil, subprocess, sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent)); import mgrub

def arg(n, d=None): return sys.argv[sys.argv.index(n) + 1] if n in sys.argv else d
pkg, out = Path(arg("--pkg", "/usr/share/material-grub")), Path(arg("--out"))
mode = (arg("--mode", "") or "").split(",")[0].split("x")
avail = sorted(p.name for p in (pkg / "res").iterdir())
size = lambda s: tuple(map(int, s.split("x")))
try: w, h = int(mode[0]), int(mode[1])
except Exception: w, h = 1920, 1080                     # 'auto'/unset -> safe default
if f"{w}x{h}" in avail: best = f"{w}x{h}"
else:  # nearest by aspect ratio first, then by size
    best = min(avail, key=lambda r: (abs(size(r)[0] / size(r)[1] - w / h) > 0.02, abs(size(r)[1] - h)))
    print(f"material-grub: {w}x{h} unsupported, using {best}", file=sys.stderr)
res = pkg / "res" / best; aspect = (res / "aspect").read_text().strip()
tmp = out.with_name(out.name + ".new"); shutil.rmtree(tmp, ignore_errors=True); tmp.mkdir(parents=True)
for f in res.iterdir():
    if f.name not in ("logo_size", "aspect"): shutil.copy(f, tmp / f.name)
conf = mgrub.load_conf(); th = tmp / "theme.txt"; th.write_text(mgrub.apply_conf_to_theme(th.read_text(), conf))   # /etc/material-grub.conf: raw name / countdown / logo on or off
(tmp / "icons").mkdir(); [shutil.copy(pkg / "fonts" / n, tmp / n) for n in ("OFL.txt", "TRADEMARKS.md") if (pkg / "fonts" / n).exists()]; (tmp / ".aspect").write_text(aspect)
# glyph fallback for non-Latin titles (the bundled Google Sans Flex is Latin only): GRUB tries every loaded font, so ship its own unicode.pf2 along
for cand in ("/usr/share/grub/unicode.pf2", "/usr/share/grub2/unicode.pf2", "/usr/share/fonts/grub/unicode.pf2", "/usr/share/fonts/truetype/unifont/unicode.pf2", "/boot/grub/fonts/unicode.pf2", "/boot/grub2/fonts/unicode.pf2"):
    if os.path.exists(cand): shutil.copy(cand, tmp / "unicode.pf2"); break
classes = json.loads((pkg / "classes.json").read_text())
for key, names in classes.items():
    src = pkg / "scenes" / aspect / "icons" / f"{names[0]}.png"
    for n in names: shutil.copyfile(src, tmp / "icons" / f"{n}.png")
if conf["LOGO"] == "on": subprocess.run([sys.executable, str(pkg / "bin/bgrt-logo.py"), str(tmp / "machine-logo.png"), "--size", (res / "logo_size").read_text().strip()],
               check=False, stdout=subprocess.DEVNULL)
shutil.rmtree(out, ignore_errors=True); os.replace(tmp, out)
print(best)
