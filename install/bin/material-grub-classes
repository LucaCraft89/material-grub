#!/usr/bin/env python3
"""Annotate grub.cfg for the Material theme and refresh BLS mirrors. stdlib only. Idempotent.
 - titles -> catalog class (case-insensitive), Windows 10/11 detection
 - unique per-entry classes (mg_xxxx) so each kernel/recovery/advanced entry gets its own scene
 - menu.json: the entries in real GRUB menu order, per menu level (the list/clean styles draw the siblings of the selected entry)
 - Fedora BLS: top level = default kernel, 'Advanced options' submenu = the rest (via mirror dirs; system files untouched)
usage: material-grub-classes GRUB_CFG [--pkg DIR] [--bls DIR] [--loader DIR] [--blsbase /loader] [--mirrors DIR --mirrorbase GRUBPATH] [--fallback-all] [--state FILE] [--default ID]
 --mirrors/--mirrorbase: where the structured BLS mirrors live (default: inside --loader). Immutable (ostree) systems keep them outside /boot/loader,
   because ostree swaps that directory on every deployment.  --fallback-all adds a raw 'All boot entries' submenu that reads the live entries,
   so a stale mirror can never hide the newest deployment."""
import json, os, re, shutil, subprocess, sys, tempfile
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent)); import mgrub

def arg(n, d=None): return sys.argv[sys.argv.index(n) + 1] if n in sys.argv else d
cfg = Path(sys.argv[1]); pkg = Path(arg("--pkg", "/usr/share/material-grub"))
bls = Path(arg("--bls", "/boot/loader/entries")); loader = Path(arg("--loader", "/boot/loader"))
blsbase = arg("--blsbase", "/loader" if os.path.ismount("/boot") else "/boot/loader")
mirrors = Path(arg("--mirrors", str(loader))); mbase = arg("--mirrorbase", blsbase); FALLBACK = "--fallback-all" in sys.argv
state = Path(arg("--state", "/var/lib/material-grub/entries.json")); cfgstate = state.with_name("cfg-entries.json"); cfgmeta = state.with_name("cfg-meta.json")
MARK = "# material-grub: classes applied"
rules = mgrub.load_rules(pkg); classes = json.loads((pkg / "classes.json").read_text())
alias2key = {a: k for k, al in classes.items() for a in al}

def os_name():
    try:
        for l in Path(os.environ.get("OS_RELEASE", "/etc/os-release")).read_text().splitlines():
            if l.startswith("NAME="): return l.split("=", 1)[1].strip('"')
    except Exception: pass
    return "Linux"

def windows_key(device):
    try:
        with tempfile.TemporaryDirectory() as mp:
            subprocess.run(["mount", "-o", "ro", device, mp], check=True, capture_output=True)
            try:
                for p in Path(mp).rglob("*"):
                    if p.name.lower() == "bootmgfw.efi":
                        s = p.read_bytes(); u = s.decode("utf-16le", "ignore") + s[1:].decode("utf-16le", "ignore")
                        m = re.search(r"10\.0\.(\d{5})\.", u)
                        if m: return "windows11" if int(m.group(1)) >= 22000 else "windows10"
            finally: subprocess.run(["umount", mp], capture_output=True)
    except Exception: pass
    return "windows11"

def key_of(title, cls=()):
    k = mgrub.key_for(title, rules)
    if k: return k
    if re.search(r"windows|microsoft", title, re.I):
        d = re.search(r"\(on (/dev/[^)\s]+)\)", title); return windows_key(d.group(1)) if d else "windows11"
    for c in cls:
        if c in alias2key: return alias2key[c]
    return "tux"

def mkentry(title, key, kind, level, cls, **kw):
    info = mgrub.parse_title(title); e = {"class": cls, "key": key, "kind": kind, "level": level, "title": title, **info}; e.update(kw); return e

# ---------------- phase 1: grub.cfg (only when not yet annotated) ----------------
text = cfg.read_text(); first = MARK not in text
bls_confs = sorted(bls.glob("*.conf")) if bls.is_dir() else []
if first:
    out, cfg_entries, stack, pstack, bls_at = [], [], [], [], 0
    pat = re.compile(r"^(\s*)(menuentry|submenu)\s+(['\"])(.*?)\3(.*)$")
    for line in text.splitlines():
        m = pat.match(line)
        if m:
            ind, word, q, title, rest = m.groups(); level = "adv" if "submenu" in stack else "top"
            cls = re.findall(r"--class\s+(\S+)", rest); key = key_of(title, cls); kind = mgrub.kind_of(title, key, word == "submenu")
            c = mgrub.uid(level, title)      # unique per entry, also for plain ones (Windows, Firmware...): their key stays the 2nd class, so the shared class scene is the fallback
            if not re.search(rf"--class {re.escape(c)}\b", rest): line = f"{ind}{word} {q}{title}{q} --class {c}{(' --class ' + key) if c != key else ''}{rest}"
            cfg_entries.append(mkentry(title, key, kind, level, c, parent=pstack[-1] if pstack else None))
            if line.rstrip().endswith("{"): stack.append(word); pstack.append(c)
        elif line.strip() == "}" and stack: stack.pop(); pstack.pop()
        elif mgrub.bls_call(line) and (stack or not mgrub.bls_restructurable(mgrub.bls_call(line))):
            if not stack: print(f"material-grub: leaving `{line.strip()}` untouched (its options are not compatible with the Advanced-options structure); entries are themed by class only")
            out.append(line); continue
        elif mgrub.bls_restructurable(mgrub.bls_call(line)) and bls_confs:
            bls_at = len(cfg_entries); osn = os_name(); k = key_of(osn); ac = mgrub.uid("adv-menu", osn); ind, bargs = mgrub.bls_call(line); bcmd = ("blscfg " + bargs).strip()
            blk = ["# material-grub: structured BLS entries (default kernel here, the rest under Advanced options)",
                   f"set blsdir={mbase}/material-top", f"if {bcmd}; then true; else unset blsdir; {bcmd}; fi",
                   f"submenu 'Advanced options for {osn}' --class {ac} --class {k} --id material-advanced {{",
                   f"\tset blsdir={mbase}/material-adv", f"\t{bcmd}", "}", "unset blsdir"]
            if FALLBACK: blk += [f"submenu 'All boot entries (raw, always current)' --class {k} --id material-fallback {{", f"\t{bcmd}", "}"]
            out += [ind + l for l in blk]
            continue
        out.append(line)
    tmp = cfg.with_name(cfg.name + ".material"); tmp.write_text(MARK + "\n" + "\n".join(out) + "\n")
    os.chmod(tmp, cfg.stat().st_mode); os.replace(tmp, cfg)
    state.parent.mkdir(parents=True, exist_ok=True); cfgstate.write_text(json.dumps(cfg_entries)); cfgmeta.write_text(json.dumps({"bls_at": bls_at}))
    print(f"material-grub: annotated {len(cfg_entries)} grub.cfg entries")
cfg_entries = json.loads(cfgstate.read_text()) if cfgstate.exists() else []
try: bls_at = json.loads(cfgmeta.read_text())["bls_at"]
except Exception: bls_at = 0       # state from an older version: the BLS block is normally the first thing in the menu

# ---------------- phase 2: BLS mirrors (always) ----------------
bls_entries = []
if bls_confs:
    def parse(f):
        d = {}
        for l in f.read_text(errors="ignore").splitlines():
            if " " in l: k, v = l.split(None, 1); d.setdefault(k, v.strip())
        return f, d
    items = [parse(f) for f in bls_confs]
    vk = lambda it: [int(x) if x.isdigit() else x for x in re.split(r"(\d+)", it[1].get("version", ""))]
    normal = sorted([i for i in items if "rescue" not in i[0].name.lower() and "rescue" not in i[1].get("title", "").lower()], key=lambda i: [(0, x) if isinstance(x, int) else (1, x) for x in vk(i)], reverse=True)
    rescue = [i for i in items if i not in normal]
    saved = arg("--default")
    if saved is None:
        for ed in ("grub2-editenv", "grub-editenv"):
            try:
                o = subprocess.run([ed, "list"], capture_output=True, text=True).stdout
                m = re.search(r"^saved_entry=(.+)$", o, re.M)
                if m: saved = m.group(1).strip(); break
            except Exception: pass
    default = next((i for i in normal if i[0].stem == saved), normal[0] if normal else None)
    for d in ("material-top", "material-adv"): shutil.rmtree(mirrors / d, ignore_errors=True); (mirrors / d).mkdir(parents=True, exist_ok=True)
    def mirror(item, where, level, is_default):
        f, d = item; title = d.get("title", f.stem); key = key_of(title, [d["grub_class"]] if "grub_class" in d else [])
        kind = mgrub.kind_of(title, key); cls = mgrub.uid(level, title)
        lines = [l for l in f.read_text(errors="ignore").splitlines() if l.strip() and not l.startswith("grub_class")] + [f"grub_class {cls}"]   # GRUB stops parsing a BLS entry at the first blank line, so the class must not follow one
        (mirrors / where / f.name).write_text("\n".join(lines) + "\n")
        bls_entries.append(mkentry(title, key, kind, level, cls, default=is_default))
    if default: mirror(default, "material-top", "top", True)
    for it in normal + rescue:
        if it is not default: mirror(it, "material-adv", "adv", False)
    osn = os_name(); k = key_of(osn)
    adv = {"class": mgrub.uid("adv-menu", osn), "key": k, "kind": "advanced", "level": "top", "title": f"Advanced options for {osn}", "count": sum(1 for e in bls_entries if e["level"] == "adv"), "os": osn}
    bls_entries.insert(1 if default else 0, adv)

# ---------------- phase 3: state for the scene renderer ----------------
allents = bls_entries + [e for e in cfg_entries if not (e["kind"] == "advanced" and bls_entries and e["title"].startswith("Advanced options for") and False)]
state.write_text(json.dumps(allents, indent=0))
# menu order: cfg entries in file order with the BLS block (default kernel, Advanced submenu) at the position of `blscfg`; its submenu contents are a level of their own.
# The raw "All boot entries" fallback submenu is not listed. Level "adv" has the class of its submenu as "parent".
top_bls = [e for e in bls_entries if e["level"] == "top"]; adv_bls = [e for e in bls_entries if e["level"] == "adv"]
top_cfg = [e for e in cfg_entries if e.get("level", "top") == "top"]; at = min(bls_at, len(top_cfg))
levels = {None: [e["class"] for e in top_cfg[:at] + top_bls + top_cfg[at:]]}
for e in cfg_entries:
    if e.get("level") == "adv": levels.setdefault(e.get("parent") or "cfg-adv", []).append(e["class"])
if adv_bls: levels[top_bls[-1]["class"]] = [e["class"] for e in adv_bls]
menu = [{"level": "top", "items": levels.pop(None)}] + [{"level": "adv", "parent": par, "items": items} for par, items in levels.items()]
state.with_name("menu.json").write_text(json.dumps(menu, indent=0))
print(f"material-grub: state has {len(allents)} entries ({len(bls_entries)} from BLS)")
