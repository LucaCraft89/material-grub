#!/usr/bin/env python3
"""Install the Material theme onto a mounted Ventoy stick. Pillow + stdlib; needs no root (only write access to the stick).
 - scans the stick for ISO/WIM/IMG/VHD files and maps each file name to a catalog distro (colour + logo only; the shown name is the raw file name)
 - renders the scenes of the chosen STYLE (rail | clean | list) like config time does on a PC, writes /ventoy/themes/material_WxH/
 - merges `theme` and `menu_class` into /ventoy/ventoy.json (backup kept, user entries stay first, --uninstall removes only what this tool added)
usage: material-grub-ventoy STICK [--pkg DIR] [--res WxH[,WxH...]] [--gfxmode MODE] [--conf FILE] [--logo FILE] [--uninstall]
The first --res is the screen mode Ventoy starts in (gfxmode); with several, Ventoy switches to the matching theme when the resolution is changed (F5 Tools). `--gfxmode max` is accepted but did not work in QEMU/OVMF (broken display).
STICK is the mount point of the Ventoy data partition. Options come from STICK/ventoy/material-grub.conf (same keys as /etc/material-grub.conf)."""
import hashlib, json, os, re, shutil, sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
import mgrub

def arg(n, d=None): return sys.argv[sys.argv.index(n) + 1] if n in sys.argv else d
EXTS = (".iso", ".wim", ".img", ".vhd", ".vhdx", ".vtoy")
VTOY_FALLBACK = ("vtoyiso", "vtoywim", "vtoyimg", "vtoyvhd", "vtoyefi", "vtoydir", "vtoyret", "vtoyvtoy")   # built-in Ventoy classes: shown when no menu_class matches (the grey disc scene)
# Ventoy's own menus (F2 browse, F3 tree, F4 local boot, F5 tools). class -> (glyph, title, subtitle, palette borrowed from a catalog entry). Verified class list: Ventoy 1.1.18 grub/*.cfg.
MENU = {"vtoydir": ("folder", "Folder", "Browse", "tux"), "vtoyret": ("back", "Back", "Previous menu", "nixos"), "F5tool": ("wrench", "Tools", "Ventoy tools", "firmware"), "F4boot": ("firmware", "Local boot", "Boot from disk", "windows10"),
        # the boot-mode menu Ventoy shows after Enter on an image (classes read from Ventoy 1.1.18's grub binary): each mode gets its own colour, background and icon
        "second_normal": ("play", "Normal mode", "Boot as usual", "reboot"), "second_grub2": ("kernel", "GRUB2 mode", "Boot through GRUB2", "tux"), "second_wimboot": ("windows11", "WIMBOOT mode", "Windows image", "windows11"),
        "second_memdisk": ("firmware", "Memdisk mode", "Load into RAM", "firmware"), "second_checksum": ("tag", "File checksum", "Verify the image", "parrot"), "second_return": ("back", "Back", "Previous menu", "nixos")}
MENU_ALIAS = {"debug_reboot": "reboot", "debug_halt": "shutdown", "debug_efisetup": "firmware", "boot_windows": "windows11"}      # items whose own scene already exists
HINTS = ["Arrows  select", "Enter  boot", "L  Language", "F1  Help", "F2  Browse", "F3  Tree", "F4  Local boot", "F5  Tools", "F6  Ext menu"]      # every key on Ventoy 1.1.18's own bar: L:Language F1:Help F2:Browse F3:TreeView F4:Localboot F5:Tools F6:ExMenu
THEMES = "ventoy/themes"; STATE = "ventoy/material-grub-state.json"

def scan(stick):
    """Image files on the stick (not inside /ventoy), in the order Ventoy lists them (case-insensitive by file name; unverified for nested folders)."""
    out = []
    for dp, dn, fn in os.walk(stick):
        if Path(dp) == Path(stick): dn[:] = [d for d in dn if d.lower() != "ventoy" and not d.startswith(".")]
        out += [str(Path(dp, f).relative_to(stick).as_posix()) for f in fn if f.lower().endswith(EXTS)]
    return sorted(out, key=lambda r: (Path(r).name.casefold(), r))

def key_of(name, rules):
    """Catalog key from an ISO file name: the PC matcher (case-insensitive tokens), then Windows 10/11 by name, else the Tux fallback."""
    stem = re.sub(r"\.[^.]+$", "", name); low = stem.lower()
    k = mgrub.key_for(stem, rules)
    if k: return k
    if re.search(r"win(dows)?[ _.\-]?10", low): return "windows10"
    if re.search(r"\bwin(dows)?\b|win(dows)?[ _.\-]?11|microsoft", low) or low.startswith("win"): return "windows11"
    return "iso"      # not recognised: the grey disc scene

def pick_key(name, others):
    """The `menu_class` key for one file. Ventoy checks it as a case-sensitive substring of the file name, but (verified on Ventoy 1.1.18) a key equal to the WHOLE name never matches
    and keys longer than 31 characters are ignored. So: the longest proper substring of at most 30 characters that no other file name contains (None: no such substring)."""
    for n in range(min(30, len(name) - 1), 0, -1):
        for i in range(len(name) - n + 1):
            s = name[i:i + n]
            if not any(s in o for o in others): return s
    return None

GENERIC = {"os", "gnu", "gnu-linux", "unknown", "win", "mx", "nix", "linux"}; SYSTEM = {"tux", "iso", "firmware", "reboot", "shutdown", "windows10", "windows11"}
WIN_KEYS = [("windows10", ("Windows10", "Windows_10", "Windows-10", "Windows 10", "Win10", "Win_10", "Win-10", "Win 10")),
            ("windows11", ("Windows11", "Windows_11", "Windows-11", "Windows 11", "Win11", "Win_11", "Win-11", "Win 11", "Windows", "Win_", "Win-", "Win "))]
# File-name pieces the catalog aliases do not cover (ISO names are not entry titles). Case-sensitive substrings; each is also tried in lower and UPPER case.
# They sort after the longer alias rules, so they only catch what nothing more specific did. Names collected from the distros' download pages / mirrors and quickemu's quickget (not all checked against live mirrors).
EXTRA_KEYS = {"mxlinux": ["MX-", "MX_"], "linuxmint": ["lmde", "LMDE"], "opensuse": ["Leap-", "SLE-", "SLES-"], "gentoo": ["install-amd64-minimal", "admincd-amd64", "livegui-amd64", "stage3-"],
              "puppy": ["Pup64", "Pup32", "Puppy", "S15Pup", "fossapup", "bionicpup", "focalpup", "bookwormpup", "Pup_"], "openbsd": ["install7", "install6", "install8", "miniroot", "cd7", "cd8"],
              "windows10": ["Win_Pro_10", "Win_Ent_10", "Win_Home_10", "Windows_10", "en_windows_10"], "windows11": ["Win_Pro_11", "Win_Ent_11", "windows_11", "windows_server"],
              "raspberrypi": ["raspios", "RaspiOS", "Raspios", "raspbian"], "freebsd": ["FreeBSD"], "tails": ["tails-amd64"], "qubes": ["Qubes"], "centos": ["CentOS"]}
def dynamic_rules(classes, titles):
    """Generic `menu_class` rules that need no list of files: every catalog alias and title in four letter-cases (as is, lower, UPPER, Capitalised), longest first.
    `key` is a case-sensitive substring in Ventoy, so the cases are what makes 'fedora-...', 'Fedora-...' and 'FEDORA-...' all match. Keys shorter than 4 chars are skipped (too many false hits)."""
    rules = {}
    for k, al in classes.items():
        if k in SYSTEM: continue
        for a in set(al) | {titles[k], titles[k].replace(" ", ""), titles[k].replace(" ", "_"), titles[k].replace(" ", "-")}:
            if a.lower() in GENERIC: continue
            for f in (a, a.lower(), a.upper(), a[:1].upper() + a[1:].lower()):
                if len(f) >= 4 and 0 < len(f) <= 30: rules.setdefault(f, f"mg_{k}")
    for k, keys in EXTRA_KEYS.items():
        for s in keys:
            for f in (s, s.lower(), s.upper()): rules.setdefault(f, f"mg_{k}")
    for k, keys in WIN_KEYS:
        for s in keys:
            for f in (s, s.lower(), s.upper()): rules.setdefault(f, f"mg_{k}")
    return [{"key": k, "class": c} for k, c in sorted(rules.items(), key=lambda kv: (-len(kv[0]), kv[0]))]

def pill_slices(out, prefix, h, rgba, w=None):
    """9-slice pieces of a pill (GRUB pixmap style `prefix_*.png`), same method as scripts/build_theme.py but with a translucent colour."""
    from PIL import Image, ImageDraw
    w = w or 2 * h + 8; S = 4; r = h // 2; im = Image.new("RGBA", (w * S, h * S), (0, 0, 0, 0))
    ImageDraw.Draw(im).rounded_rectangle([0, 0, w * S - 1, h * S - 1], radius=r * S, fill=rgba); im = im.resize((w, h), Image.LANCZOS)
    cs = r - 1; xs = [(0, cs), (cs, w - cs), (w - cs, w)]; ys = [(0, cs), (cs, h - cs), (h - cs, h)]; names = [["nw", "n", "ne"], ["w", "c", "e"], ["sw", "s", "se"]]
    for j, (y0, y1) in enumerate(ys):
        for i, (x0, x1) in enumerate(xs): im.crop((x0, y0, x1, y1)).save(out / f"{prefix}_{names[j][i]}.png")

def native_list(text, W, H, light):
    """theme.txt block for the dynamic `list` style: a boot_menu with one translucent pill per entry (works for any number of ISOs, GRUB scrolls it), placed before the scene menu so it is drawn on top."""
    f = H / 1080; font = re.findall(r'item_font = "([^"]+)"', text)[-1]; q = lambda v: round(v * f)
    h, pitch, N = q(76), q(88), 7; cs = h // 2 - 1; ih = h - 2 * cs      # N rows of h px, one every `pitch` px
    x0, y0, w = round(W * 0.47), q(110), q(640)
    # GRUB grows every item box DOWNWARDS by the pixmap's edge slices (2*cs px; verified, no growth sideways or upwards) and clips text to the item rectangle, so two synchronised lists are used:
    # the pills (a 2 px item rectangle that the pixmap grows into a pill) and, on top, the text (full-height items, no pixmap)
    def menu(left, top, width, height, item_h, spacing, color, sel_color, pix):
        return f'''+ boot_menu {{
  left = {left}
  top = {top}
  width = {width}
  height = {height}
  item_height = {item_h}
  item_spacing = {spacing}
  item_padding = 0
  item_icon_space = 0
  icon_width = 1
  icon_height = 1
  item_font = "{font}"
  selected_item_font = "{font}"
  item_color = "{color}"
  selected_item_color = "{sel_color}"
{pix}  scrollbar = false
}}
'''
    ink, sel = ("#1B1B1F", "#000000") if light else ("#E6E1E5", "#FFFFFF")
    block = "# mg:list rows drawn by GRUB (dynamic list): text on top, pills below\n" + menu(x0 + q(30), y0, w - q(60), N * pitch - (pitch - h), h, pitch - h, ink, sel, "") + "\n" \
          + menu(x0, y0, w, N * pitch - (pitch - h), ih, pitch - ih, "#00000000", "#00000000", '  item_pixmap_style = "mgrow_*.png"\n  selected_item_pixmap_style = "mgsel_*.png"\n') + "\n"
    mark = "# GRUB draws the first-declared component on top"
    return text.replace(mark, block + mark, 1) if mark in text else text + block

def logo_png(path, size, src=None):
    """The logo drawn in the cookie: the real Ventoy logo (blue disc with a USB stick, shipped in the package, full colour) or `src`, any image of your own. Both keep their colours."""
    from PIL import Image
    src = Path(src) if src else next((c for c in (PKG / "ventoy/VentoyLogo.png", Path(__file__).resolve().parents[2] / "vendor/ventoy/VentoyLogo.png") if c.exists()), None)
    if src is None: sys.exit("material-grub-ventoy: the Ventoy logo is missing from the package (ventoy/VentoyLogo.png); pass --logo FILE or --no-logo")
    im = Image.open(src).convert("RGBA"); bb = im.getchannel("A").point(lambda v: 255 if v > 8 else 0).getbbox(); im = im.crop(bb) if bb else im      # trim the empty border
    s = size / max(im.size); im = im.resize((max(1, round(im.width * s)), max(1, round(im.height * s))), Image.LANCZOS)
    out = Image.new("RGBA", (size, size), (0, 0, 0, 0)); out.alpha_composite(im, ((size - im.width) // 2, (size - im.height) // 2)); out.save(path)

def load_json(p):
    try: return json.loads(Path(p).read_text() or "{}")
    except FileNotFoundError: return {}

stick = Path(sys.argv[1]) if len(sys.argv) > 1 and not sys.argv[1].startswith("--") else None
if not stick or not (stick / "ventoy").is_dir(): sys.exit("material-grub-ventoy: STICK must be the mount point of a Ventoy data partition (it has no /ventoy folder)")
PKG = Path(arg("--pkg", "/usr/share/material-grub")); vj_path = stick / "ventoy/ventoy.json"; state_path = stick / STATE
state = load_json(state_path)

def uninstall():
    vj = load_json(vj_path); mine = state.get("menu_class", [])
    vj["menu_class"] = [m for m in vj.get("menu_class", []) if m not in mine]
    if not vj["menu_class"]: vj.pop("menu_class")
    th = vj.get("theme", {}); ours = state.get("theme_files", [])
    files = th.get("file"); files = [files] if isinstance(files, str) else files or []
    if files and all(f in ours for f in files):
        vj.pop("theme", None)
        if state.get("prev_theme"): vj["theme"] = state["prev_theme"]
    vj_path.write_text(json.dumps(vj, indent=1) + "\n")
    for d in state.get("theme_dirs", []): shutil.rmtree(stick / d, ignore_errors=True)
    state_path.unlink(missing_ok=True); (stick / "ventoy/material-grub.conf").unlink(missing_ok=True)
    try: (stick / THEMES).rmdir()          # only if empty: other themes stay
    except OSError: pass
    print("material-grub-ventoy: removed")

if "--uninstall" in sys.argv: uninstall(); sys.exit(0)

try: import mgscenes; from PIL import Image
except ImportError: sys.exit("material-grub-ventoy: Pillow is required")
conf = mgrub.load_conf(arg("--conf", str(stick / "ventoy/material-grub.conf"))); style = conf["STYLE"]
if style == "split": style = "list"      # the Ventoy list already is hero-left / list-right
conf["COUNTDOWN"] = "on" if conf["TIMEOUT"] else "off"          # Ventoy has no timeout unless one is configured
rules = mgrub.load_rules(PKG); classes = json.loads((PKG / "classes.json").read_text())
avail = sorted(p.name for p in (PKG / "res").iterdir())
resl = [r for r in (arg("--res") or "").split(",") if r] or avail[:1]
for r in resl:
    if r not in avail: sys.exit(f"material-grub-ventoy: resolution {r} is not in the package (has: {', '.join(avail)})")

dynamic = conf["MODE"] == "dynamic"      # dynamic: nothing depends on the files on the stick (generic rules, one scene per distro); snapshot: scenes are rendered for the files that are there now
titles = json.loads((PKG / "titles.json").read_text())
SECTIONS = [["tux"], ["windows11"], ["wrench"]]; section = lambda k: "windows11" if k in ("windows10", "windows11") else "wrench" if k in ("firmware", "reboot", "shutdown") else "" if k == "iso" else "tux"      # dynamic rail: one slot per section, the slot of the selected entry is lit
files = [] if dynamic else scan(stick)
entries = []
for rel in files:
    name = Path(rel).name; k = key_of(name, rules)
    entries.append({"class": mgrub.uid("ventoy", rel), "key": k, "kind": "plain", "level": "top", "title": name, "label": name, "path": rel})
keys = sorted({e["key"] for e in entries}) or ["iso"]
if dynamic: keys = list(classes)
groups = mgscenes.groups_of(keys); by_class = {e["class"]: e for e in entries}
menu = [{"level": "top", "items": [e["class"] for e in entries]}]
opts = {"cookie": conf["COOKIE"] == "on", "hints": conf["HINTS"] == "on", "shape": "cookie"}
per_entry = style != "rail"
print(f"material-grub-ventoy: mode {conf['MODE']}, {len(entries)} images, {len(keys)} distros, style {style}, resolutions {', '.join(resl)}")

theme_dirs, theme_files, fonts, menu_class = [], [], [], []
for res in resl:
    rdir = PKG / "res" / res; aspect = (rdir / "aspect").read_text().strip(); rel_dir = f"{THEMES}/material_{res}"; out = stick / rel_dir
    tmp = out.with_name(out.name + ".new"); shutil.rmtree(tmp, ignore_errors=True); (tmp / "icons").mkdir(parents=True)
    for f in rdir.iterdir():
        if f.name not in ("logo_size", "aspect"): shutil.copy(f, tmp / f.name)
    th = tmp / "theme.txt"; th.write_text(mgrub.apply_conf_to_theme(th.read_text(), conf))
    if dynamic and style == "list":
        rw, rh = map(int, res.split("x")); light = (PKG / "scheme.txt").read_text().strip() == "light" if (PKG / "scheme.txt").exists() else False
        th.write_text(native_list(th.read_text(), rw, rh, light)); q = round(76 * rh / 1080)
        pill_slices(tmp, "mgrow", q, (0, 0, 0, 20) if light else (255, 255, 255, 24)); pill_slices(tmp, "mgsel", q, (0, 0, 0, 52) if light else (255, 255, 255, 70))
    for n in ("OFL.txt", "TRADEMARKS.md"):
        if (PKG / "fonts" / n).exists(): shutil.copy(PKG / "fonts" / n, tmp / n)
    for cand in ("/usr/share/grub/unicode.pf2", "/usr/share/grub2/unicode.pf2", "/usr/share/fonts/grub/unicode.pf2", "/usr/share/fonts/truetype/unifont/unicode.pf2", "/boot/grub/fonts/unicode.pf2", "/boot/grub2/fonts/unicode.pf2"):
        if os.path.exists(cand): shutil.copy(cand, tmp / "unicode.pf2"); break
    if conf["LOGO"] == "on" and conf["COOKIE"] == "on": logo_png(tmp / "machine-logo.png", int((rdir / "logo_size").read_text().strip()), arg("--logo"))
    bgs = sorted((PKG / "scenes" / aspect / "bg").glob("*.png")); R = mgscenes.Renderer(PKG, Image.open(bgs[0]).height); R.bg_dir = PKG / "scenes" / aspect / "bg"; R.hint_labels = HINTS
    cls_scene = lambda k: PKG / "scenes" / aspect / "icons" / f"{classes[k][0]}.png"
    def class_scene(k):
        if dynamic and style == "list": return R.render_list_hero(k, PKG / "scenes" / aspect / "bg" / f"{k}.png", opts)
        if dynamic: return R.render_class(k, cls_scene(k), SECTIONS, style, opts, [], rail_sel=section(k))      # rail with sections; clean without neighbours
        # snapshot -- rail: the whole story. clean: a panel without neighbours. list: the whole list, nothing highlighted (also what an ISO added after install gets)
        if style == "list": return R.render_list_fallback(k, PKG / "scenes" / aspect / "bg" / f"{k}.png", entries, opts)
        return R.render_class(k, cls_scene(k), groups, style, opts, menu)
    for k in keys: class_scene(k).save(tmp / "icons" / f"mg_{k}.png")
    generic = Image.open(tmp / "icons" / "mg_iso.png") if "iso" in keys else class_scene("iso")      # Ventoy's own classes (vtoyiso, vtoywim, ...) and every file the rules do not recognise
    for c in VTOY_FALLBACK: generic.save(tmp / "icons" / f"{c}.png")
    if dynamic:       # the existing scenes for Ventoy's power / firmware / Windows items
        for c, k in MENU_ALIAS.items(): shutil.copy(tmp / "icons" / f"mg_{k}.png", tmp / "icons" / f"{c}.png")
    if dynamic or style != "list":       # Ventoy's own menus: a scene each (folder, back, tools, local boot, the boot modes); the snapshot list bakes its rows into the scenes, so it has none
        for c, (glyph, title, sub, pal) in MENU.items():
            pk = f"mgm_{c}"; R.pal[pk] = R.pal[pal]; R.titles[pk] = title; R.galias[pk] = glyph; bg = PKG / "scenes" / aspect / "bg" / f"{pal}.png"
            if style == "list": img = R.render_list_hero(pk, bg, opts)
            else:
                sc = Image.open(bg).convert("RGBA"); R.hero(sc, {"key": pk, "kind": "kernel", "title": sub}, R.pal[pk])
                img = R.render_clean({"key": pk, "kind": "plain", "title": title}, sc, None, None, opts).convert("RGB") if style == "clean" else None
                if img is None: R.decorate(sc, R.pal[pk], opts); R.draw_rail(sc, R.pal[pk], SECTIONS, "wrench"); img = sc.convert("RGB")
            img.save(tmp / "icons" / f"{c}.png")
    if per_entry and not dynamic:
        for e in entries:
            src = PKG / "scenes" / aspect / ("icons" if style != "list" else "bg") / (f"{classes[e['key']][0]}.png" if style != "list" else f"{e['key']}.png")
            R.render_entry(e, src, groups, style, opts, menu, by_class).save(tmp / "icons" / f"{e['class']}.png")
    shutil.rmtree(out, ignore_errors=True); os.replace(tmp, out)
    theme_dirs.append(rel_dir); theme_files.append(f"/{rel_dir}/theme.txt")
    fonts += [f"/{rel_dir}/{p.name}" for p in sorted(out.glob("*.pf2"))]

# ---- ventoy.json: merge, never overwrite ----
bak = vj_path.with_name("ventoy.json.material-grub.bak")
if vj_path.exists() and not bak.exists(): shutil.copy(vj_path, bak)
vj = load_json(vj_path); old_mine = state.get("menu_class", [])
user_mc = [m for m in vj.get("menu_class", []) if m not in old_mine]
names = sorted({Path(e["path"]).name for e in entries})
if dynamic: menu_class = dynamic_rules(classes, titles)
for e in ([] if dynamic else entries):
    name = Path(e["path"]).name; key = pick_key(name, [o for o in names if o != name])
    if key is None: print(f"material-grub-ventoy: warning: no unique key for {name}; it keeps the generic scene"); continue
    menu_class.append({"key": key, "class": e["class"] if per_entry else f"mg_{e['key']}"})
seen = set(); menu_class = [m for m in menu_class if not (m["key"] in seen or seen.add(m["key"]))]
vj["menu_class"] = user_mc + menu_class                                          # the user's own rules come first and win
th = vj.get("theme", {}); ours = state.get("theme_files", [])
cur = th.get("file"); cur = [cur] if isinstance(cur, str) else cur or []
prev = state.get("prev_theme") if cur and all(c in ours for c in cur) else (th or None)
th.update({"file": theme_files[0] if len(theme_files) == 1 else theme_files, "gfxmode": arg("--gfxmode") or resl[0], "fonts": fonts})
if len(theme_files) > 1: th.update({"default_file": 0, "resolution_fit": 1})
else: th.pop("default_file", None); th.pop("resolution_fit", None)
vj["theme"] = th
vj_path.write_text(json.dumps(vj, indent=1) + "\n")
state_path.write_text(json.dumps({"menu_class": menu_class, "theme_files": theme_files, "theme_dirs": theme_dirs, "prev_theme": prev}, indent=1))
print(f"material-grub-ventoy: wrote {', '.join(theme_dirs)} and merged ventoy.json ({len(menu_class)} menu_class rules); backup: {bak.name}")
