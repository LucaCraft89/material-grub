#!/usr/bin/env python3
"""Bake the section rail (Linux | Windows | System) into the active theme's scenes. Needs Pillow.
usage: material-grub-rail --theme DIR [--cfg grub.cfg] [--bls DIR] [--pkg DIR]"""
import json, re, shutil, sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent)); import mgrub
try: from PIL import Image, ImageDraw
except ImportError: print("material-grub: Pillow missing, rail disabled", file=sys.stderr); sys.exit(0)

def arg(n, d=None): return sys.argv[sys.argv.index(n) + 1] if n in sys.argv else d
pkg = Path(arg("--pkg", "/usr/share/material-grub")); theme = Path(arg("--theme"))
cfg = Path(arg("--cfg", "/boot/grub2/grub.cfg" if Path("/boot/grub2/grub.cfg").exists() else "/boot/grub/grub.cfg"))
bls = Path(arg("--bls", "/boot/loader/entries"))
classes = json.loads((pkg / "classes.json").read_text()); pal = json.loads((pkg / "palettes.json").read_text())
rules = mgrub.load_rules(pkg); alias2key = {a: k for k, al in classes.items() for a in al}
aspect = (theme / ".aspect").read_text().strip()
WIN, SYS = {"windows10", "windows11"}, {"firmware", "reboot", "shutdown"}

def key_of(title, cls):
    for c in cls:
        if c in alias2key: return alias2key[c]
    return mgrub.key_for(title, rules) or "tux"

# ---- collect keys in menu order ----
bls_keys = []
if bls.is_dir():
    for f in sorted(bls.glob("*.conf"), reverse=True):
        t = {}; 
        for line in f.read_text(errors="ignore").splitlines():
            if " " in line: k, v = line.split(None, 1); t[k] = v.strip()
        bls_keys.append(key_of(t.get("title", ""), [t["grub_class"]] if "grub_class" in t else []))
keys = []
def add(k):
    if k not in keys: keys.append(k)
try: text = cfg.read_text()
except Exception: text = ""
for line in text.splitlines():
    if line.strip() == "blscfg": [add(k) for k in bls_keys]; continue
    m = re.match(r"^\s*menuentry\s+(['\"])(.*?)\1(.*)$", line)
    if m: add(key_of(m.group(2), re.findall(r"--class\s+(\S+)", m.group(3))))
if not keys: [add(k) for k in bls_keys]
groups = [g for g in ([k for k in keys if k not in WIN | SYS], [k for k in keys if k in WIN],
                      [k for k in ("firmware", "reboot", "shutdown") if k in keys]) if g]
if not groups: sys.exit(0)

# ---- geometry (design px at 1080 high; scenes are stored at design size) ----
SLOT, GAP, DIV, PADV, RW, LM, SS = 72, 10, 30, 22, 100, 52, 3
n = sum(map(len, groups)); H_rail = n * SLOT + (n - len(groups)) * GAP + (len(groups) - 1) * DIV + 2 * PADV
hexc = lambda c: tuple(int(c[i:i + 2], 16) for i in (1, 3, 5))
glyphs = {}
def glyph(k, color, size=40):
    g = glyphs.setdefault(k, Image.open(pkg / "glyphs" / f"{k}.png").convert("RGBA").getchannel("A"))
    g = g.resize((size, size), Image.LANCZOS); im = Image.new("RGBA", (size, size), color); im.putalpha(g); return im

def render(sel):
    p = pal[sel]; src = pkg / "scenes" / aspect / "icons" / f"{classes[sel][0]}.png"
    sc = Image.open(src).convert("RGBA"); W, H = sc.size
    top = (H - H_rail) // 2
    layer = Image.new("RGBA", (RW * SS, H_rail * SS), (0, 0, 0, 0)); d = ImageDraw.Draw(layer)
    d.rounded_rectangle([0, 0, RW * SS - 1, H_rail * SS - 1], radius=RW * SS // 2, fill=hexc(p["surfaceContainerHigh"]) + (255,))
    y = PADV; slots = []
    for gi, g in enumerate(groups):
        if gi: 
            ly = y + DIV // 2 - (GAP // 2) ; d.rounded_rectangle([(RW // 2 - 14) * SS, ly * SS, (RW // 2 + 14) * SS, (ly + 2) * SS], radius=SS, fill=hexc(p["outline"]) + (150,))
            y += DIV - GAP
        for k in g: slots.append((k, y)); y += SLOT + GAP
    for k, sy in slots:
        if k == sel:
            d.rounded_rectangle([(RW - SLOT) // 2 * SS, sy * SS, ((RW + SLOT) // 2) * SS - 1, (sy + SLOT) * SS - 1], radius=26 * SS, fill=hexc(p["primaryContainer"]) + (255,))
    layer = layer.resize((RW, H_rail), Image.LANCZOS)
    for k, sy in slots:
        gl = glyph(k, hexc(p["onPrimaryContainer"]) + (255,) if k == sel else (244, 244, 247, 235))
        layer.alpha_composite(gl, ((RW - 40) // 2, sy + (SLOT - 40) // 2))
    sc.alpha_composite(layer, (LM, top)); return sc.convert("RGB")

for k in keys:
    img = render(k); first = theme / "icons" / f"{classes[k][0]}.png"
    img.save(first)
    for a in classes[k][1:]: shutil.copyfile(first, theme / "icons" / f"{a}.png")
print(f"material-grub: rail baked for {len(keys)} classes: {' | '.join(' '.join(g) for g in groups)}")
