#!/bin/sh
# /etc/grub.d/05_material — Material 3 Expressive theme. Runs inside grub-mkconfig.
set -e
PKG=${MATERIAL_PKG:-/usr/share/material-grub}
. "${pkgdatadir:-/usr/share/grub}/grub-mkconfig_lib"
[ -d "$PKG" ] || exit 0
if [ -n "$MATERIAL_GRUBDIR" ]; then GDIR=$MATERIAL_GRUBDIR; elif [ -d /boot/grub2 ]; then GDIR=/boot/grub2; else GDIR=/boot/grub; fi
THEMEDIR=$GDIR/themes/material
MODE=$(python3 "$PKG/bin/material-grub-assemble" --mode "${GRUB_GFXMODE:-}" --pkg "$PKG" --out "$THEMEDIR" 2>/dev/null | tail -n1) || exit 0
[ -n "$MODE" ] || exit 0
# shellcheck disable=SC2154 # grub_probe comes from grub-mkconfig_lib
prepare_grub_to_access_device "$(${grub_probe} --target=device "$THEMEDIR")"
REL=$(make_system_path_relative_to_its_root "$THEMEDIR")
cat << EOF
# --- Material 3 Expressive theme ($MODE) ---
set gfxmode=$MODE,auto
set gfxpayload=keep
insmod all_video
insmod gfxterm
insmod gfxmenu
insmod png
terminal_output gfxterm
loadfont (\$root)$REL/MG-Label.pf2
loadfont (\$root)$REL/MG-Raw.pf2
EOF
[ -f "$THEMEDIR/unicode.pf2" ] && echo "loadfont (\$root)$REL/unicode.pf2"   # non-Latin fallback glyphs
cat << EOF
set theme=(\$root)$REL/theme.txt
export theme
EOF
