#!/bin/sh
# Re-apply Material GRUB after editing /etc/material-grub.conf (or to force a refresh).
set -e
[ "$(id -u)" -eq 0 ] || { echo "run as root: sudo $0"; exit 1; }
if [ -f /var/lib/material-grub/env ] && grep -q '^MG_IMMUTABLE=1' /var/lib/material-grub/env; then
  MG_FORCE=1 exec sh /var/lib/material-grub/postprocess
fi
MK=$(command -v grub2-mkconfig || command -v grub-mkconfig) || { echo "grub-mkconfig not found"; exit 1; }
CFG=/boot/grub2/grub.cfg; [ -f "$CFG" ] || CFG=/boot/grub/grub.cfg
if command -v flock >/dev/null; then   # same lock as the path unit: no run may restore an old snapshot over the file written here
  MG_FORCE=1 MG_LOCKED=1 flock /run/material-grub.lock sh -c '"$1" -o "$2" && /usr/libexec/material-grub-postprocess' sh "$MK" "$CFG"
else
  "$MK" -o "$CFG" && MG_FORCE=1 /usr/libexec/material-grub-postprocess
fi
