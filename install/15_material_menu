#!/bin/sh
# /etc/grub.d/15_material_menu — always show the menu (Fedora's 12_menu_auto_hide would hide it).
T=$(sed -n 's/^[[:space:]]*TIMEOUT=\([0-9][0-9]*\)[[:space:]]*\(#.*\)\{0,1\}$/\1/p' "${MATERIAL_CONF:-/etc/material-grub.conf}" 2>/dev/null | tail -n1)   # TIMEOUT in /etc/material-grub.conf wins over GRUB_TIMEOUT
cat << EOF
# --- Material GRUB: keep the menu visible ---
set timeout_style=menu
set timeout=${T:-${GRUB_TIMEOUT:-5}}
unset menu_hide_ok
EOF
