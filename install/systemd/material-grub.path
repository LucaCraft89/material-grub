[Unit]
Description=Re-apply Material GRUB classes and rail when grub.cfg or boot entries change
[Path]
PathChanged=/boot/grub2/grub.cfg
PathChanged=/boot/grub/grub.cfg
PathChanged=/boot/loader/entries
PathChanged=/boot/grub2/grubenv
PathChanged=/boot/grub/grubenv
PathChanged=/etc/material-grub.conf
[Install]
WantedBy=multi-user.target
